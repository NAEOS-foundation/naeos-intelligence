# Copy this file to .env and adjust values as needed.
# Never commit .env with real secrets to version control.

# Database
DATABASE_URL=postgres://naeos:naeos@localhost:5432/naeos_intelligence_dev?sslmode=disable

# HTTP server
NAEOS_INTELLIGENCE_HTTP_ADDR=0.0.0.0:8080
NAEOS_INTELLIGENCE_APP_ENVIRONMENT=development
NAEOS_INTELLIGENCE_APP_LOG_LEVEL=debug

# Rate limiting
NAEOS_INTELLIGENCE_RATE_LIMIT_RATE=10
NAEOS_INTELLIGENCE_RATE_LIMIT_BURST=20

# OpenAPI spec path
NAEOS_INTELLIGENCE_OPENAPI_SPEC_PATH=api/openapi.yaml

# Read-only engineering context providers
NAEOS_INTELLIGENCE_CORE_API_BASE_URL=http://127.0.0.1:8081/api
# Docker Compose override: Core is published on the host at port 8081.
NAEOS_INTELLIGENCE_DOCKER_CORE_API_BASE_URL=http://host.docker.internal:8081/api
NAEOS_CORE_SERVICE_TOKEN=
GITHUB_TOKEN=

# Authentication (JWKS) — required for protected routes; leave empty for fail-closed
NAEOS_AUTH_ISSUER=
NAEOS_AUTH_AUDIENCE=
NAEOS_AUTH_JWKS_URL=
